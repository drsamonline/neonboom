{
  "name": "NEONBOOM — browser beat workstation",
  "short_name": "NEONBOOM",
  "description": "Offline-first beat workstation in the browser: procedural loop library, pad grid, arrangement timeline, mixer, master FX and WAV export. No install, no account, no upload.",
  "id": "/",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#08090b",
  "theme_color": "#0b0d10",
  "categories": [
    "music",
    "productivity",
    "entertainment"
  ],
  "icons": [
    {
      "src": "assets/img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Open pads",
      "url": "./index.html?view=pads"
    },
    {
      "name": "Open arrangement",
      "url": "./index.html?view=arrange"
    }
  ]
}