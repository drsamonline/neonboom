{
  "name": "neonboom",
  "version": "2.6.0",
  "description": "Offline-first beat workstation that runs in a browser tab: procedural loop library, pad grid, canvas arrangement, mixer, master FX and WAV export. Zero dependencies.",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Dr Sohil Momin",
    "email": "sohilmomin2000@gmail.com",
    "url": "https://github.com/drsamonline"
  },
  "homepage": "https://drsamonline.github.io/neonboom/",
  "repository": {
    "type": "git",
    "url": "https://github.com/drsamonline/neonboom.git"
  },
  "keywords": [
    "web-audio",
    "daw",
    "beat-maker",
    "sampler",
    "music",
    "offline",
    "pwa",
    "vanilla-js",
    "canvas"
  ],
  "scripts": {
    "build": "node scripts/build-standalone.mjs",
    "test": "node tests/run.mjs && node tests/extended.mjs",
    "screenshots": "node tests/screenshots.mjs",
    "serve": "npx --yes serve .",
    "test:offline": "node tests/offline.mjs",
    "build:pack": "node scripts/build-pack.mjs",
    "test:pack": "node tests/pack.mjs",
    "test:extended": "node tests/extended.mjs",
    "test:layout": "node tests/layout.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^23.0.0",
    "terser": "^5.51.2"
  }
}
